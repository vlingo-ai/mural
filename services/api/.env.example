# Local development only. Supply real secrets through the deployment environment.
DATABASE_URL=postgresql://mural:local-development-only@localhost:5432/mural
PORT=8080
PUBLIC_ORIGIN=http://localhost:8080
GOOGLE_IOS_CLIENT_ID=
# Separate browser OAuth audience; retain the native audience above for iOS.
GOOGLE_WEB_CLIENT_ID=
ACCOUNTS_ENABLED=false
# Required only when accounts are enabled. Use distinct random 32-byte lowercase hex values.
ACCOUNTS_HMAC_KEY=
ACCOUNTS_PROXY_TOKEN=
ACCOUNTS_ALLOW_LOCAL_LOOPBACK=false
# Android uses a web client audience plus an explicit list of Android OAuth client IDs.
GOOGLE_ANDROID_SERVER_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_IDS=
APPLE_CLIENT_ID=
# Native Apple revocation requires a read-only .p8 secret file and developer credentials.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
# Keep off for public deployments. Hosted access requires an explicit test-account allowlist.
HOSTED_VOICE_EXPERIMENTAL=false
HOSTED_VOICE_ACCOUNT_ALLOWLIST=
HOSTED_VOICE_LIFETIME_CAP_NANO=0
HOSTED_VOICE_BILLING_UNIT=nanoUSD
# Helpers require milliseconds billing and an explicitly reviewed provider-cost allowance.
HOSTED_HELPERS_EXPERIMENTAL=false
HOSTED_HELPER_BUDGET_PER_MINUTE_NANO=0
HOSTED_HELPER_REQUESTS_PER_MINUTE=24
HOSTED_HELPER_SEARCHES_PER_SESSION=0
# Standalone account-funded work is separately gated. Phase 4B initially allows topic search only.
ACCOUNT_MODEL_TASKS_EXPERIMENTAL=false
MURAL_WEB_ALLOWED_ORIGINS=http://127.0.0.1:5173
ACCOUNT_MODEL_TASK_REQUESTS_PER_MINUTE=3
OPENAI_API_KEY=
# Preferred Live and hosted-helper Responses route. Set both values or neither; production origins require HTTPS.
# Loopback HTTP is accepted for local development.
MODEL_GATEWAY_URL=
MODEL_GATEWAY_API_KEY=
# Optional Phase 5.5 media path. When set, Web receives a short-lived room token while the
# OpenAI key remains in the isolated LiveKit Agent Worker. Use a random 32+ byte control
# secret; local `livekit-server --dev` uses devkey/secret only for development.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_CONTROL_SECRET=
LIVEKIT_AGENT_NAME=mural-gpt-live
# Legacy credit sandbox; Android minute purchases use the separate configuration below.
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
# Server-side Stripe Price IDs; the client never supplies a price or credit amount.
STRIPE_TEST_PRICE_10_USD=
STRIPE_TEST_PRICE_25_USD=
# Match the exact fee-inclusive sandbox Stripe Prices you create. No default fee is invented.
STRIPE_TEST_PAYMENT_FEE_10_MINOR=
STRIPE_TEST_PAYMENT_FEE_25_MINOR=
# Minute commerce has no default product, price or credential. See docs/enable-minute-commerce.md.
MURAL_MINUTE_COMMERCE_ENABLED=false
MURAL_MINUTE_SALES_ENABLED=false
MURAL_MINUTE_ALLOW_LIVE=false
MURAL_MINUTE_COMMERCE_CONFIG_FILE=
MURAL_MINUTE_CATALOG_FILE=
MURAL_MINUTE_CATALOG_APPROVED_SHA256=
MURAL_MINUTE_RECEIPT_KEYS_FILE=
MURAL_MINUTE_STRIPE_CREDENTIALS_FILE=
MURAL_MINUTE_PLAY_SERVICE_ACCOUNT_FILE=
MURAL_MINUTE_PLAY_BINDING_KEY_FILE=
