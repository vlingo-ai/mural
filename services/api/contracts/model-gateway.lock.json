{
  "protocol": "vlingo.model-gateway",
  "protocolVersion": "1.0",
  "requiredHTTPPaths": [
    "/v1/capabilities",
    "/v1/responses"
  ],
  "requiredSchemas": [
    "GatewayResponse",
    "GatewayResponseRequest",
    "ModelGatewayCapabilities",
    "ResponseSource",
    "TokenUsage"
  ],
  "requiredResponseFields": [
    "sources"
  ],
  "requiredResponseUsageFields": [
    "cache_write_input_tokens",
    "web_search_calls"
  ],
  "requiredSidebandSchemas": [],
  "profiles": {
    "responses": {},
    "legacy-live": {
      "requiredHTTPPaths": ["/v1/live/sessions"],
      "requiredSchemas": ["LiveSessionCreateRequest", "LiveSessionResponse"],
      "requiredSidebandSchemas": [
        "events/live-client-commands.v1.schema.json",
        "events/live-server-events.v1.schema.json"
      ]
    }
  }
}
