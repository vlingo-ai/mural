{
  "openapi": "3.1.0",
  "info": {
    "title": "Mural Public API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/live/sessions": {
      "post": {
        "operationId": "createLiveSession",
        "summary": "Create a Mural Live session using the server-selected transport",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LiveSessionCreateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Live session created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveSession"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/live/sessions/{sessionID}": {
      "get": {
        "operationId": "getLiveSession",
        "summary": "Get the authenticated user's Live session status",
        "parameters": [
          {
            "$ref": "#/components/parameters/SessionID"
          }
        ],
        "responses": {
          "200": {
            "description": "Current session status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveSessionStatus"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/live/sessions/{sessionID}/close": {
      "post": {
        "operationId": "closeLiveSession",
        "summary": "Request an authenticated user's Live session to close",
        "parameters": [
          {
            "$ref": "#/components/parameters/SessionID"
          }
        ],
        "responses": {
          "200": {
            "description": "Close request accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveSessionStatus"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [],
                "properties": {}
              }
            }
          }
        }
      }
    },
    "/v1/conversations": {
      "get": {
        "operationId": "listConversations",
        "summary": "List the authenticated user's server-authoritative conversation history",
        "responses": {
          "200": {
            "description": "Recent conversations",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationList"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/conversations/{sessionID}": {
      "get": {
        "operationId": "getConversation",
        "summary": "Get transcript fragments and learning results for an owned conversation",
        "parameters": [
          {
            "$ref": "#/components/parameters/SessionID"
          }
        ],
        "responses": {
          "200": {
            "description": "Conversation detail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationDetail"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/conversations/{sessionID}/events": {
      "post": {
        "operationId": "appendConversationEvent",
        "summary": "Idempotently append a bounded frontend-visible transcript fragment",
        "parameters": [
          {
            "$ref": "#/components/parameters/SessionID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConversationEventInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Event accepted or previously stored",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "accepted",
                    "duplicate"
                  ],
                  "properties": {
                    "accepted": {
                      "const": true
                    },
                    "duplicate": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/model-tasks": {
      "post": {
        "operationId": "createModelTask",
        "summary": "Execute a server-owned Mural language-learning task",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ModelTaskRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task completed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelTaskResult"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/live/capabilities": {
      "get": {
        "operationId": "getLiveCapabilities",
        "summary": "Read gated Live availability and server-selected transport",
        "security": [
          {},
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current runtime response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveCapabilities"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/live/sessions/current": {
      "get": {
        "operationId": "getCurrentLiveSession",
        "summary": "Read the current non-closed minute-funded session, or null",
        "responses": {
          "200": {
            "description": "Current runtime response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentLiveSession"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/live/sessions/{sessionID}/helpers": {
      "post": {
        "operationId": "requestHostedHelper",
        "summary": "Existing funded helper compatibility endpoint",
        "parameters": [
          {
            "$ref": "#/components/parameters/SessionID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HostedHelperRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JSON by default. Explicit Accept: text/event-stream with positive valid q opts into SSE. Each data frame is a HostedHelperStreamEvent JSON object. Completed or error terminates the stream; disconnect is not permission to retry the funded request. Admission failures before first frame remain HTTP errors.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HostedHelperResult"
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "SSE data: JSON followed by a blank line; no event ID/resume guarantee."
                },
                "x-event-schema": {
                  "$ref": "#/components/schemas/HostedHelperStreamEvent"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        }
      },
      "SessionID": {
        "name": "sessionID",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "responses": {
      "Error": {
        "description": "Safe error response",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "retryable": {
                "type": "boolean",
                "description": "Only helper_session_limit supplies retry guidance; absence is not permission to retry."
              },
              "retryAfterMilliseconds": {
                "type": "integer",
                "minimum": 1,
                "description": "Present for retryable helper_session_limit; HTTP Retry-After rounds up to seconds."
              }
            }
          }
        }
      },
      "LiveSessionCreateRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "language"
        ],
        "properties": {
          "language": {
            "type": "string",
            "enum": [
              "en",
              "zh-CN"
            ],
            "description": "API compatibility values; UI availability is a separate release policy."
          },
          "sdp": {
            "type": "string",
            "pattern": "^v=0",
            "maxLength": 65536,
            "description": "Legacy WebRTC only, at most 65536 UTF-8 bytes. Omit for livekit-room. Transport is selected by server capabilities, not by a request transport object."
          },
          "requestedMilliseconds": {
            "type": "integer",
            "minimum": 60000,
            "maximum": 3600000
          },
          "instructions": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000,
            "deprecated": true,
            "description": "Existing compatibility field, at most 12000 UTF-8 bytes; not a new client prompt authority. Whitespace/control-character validation also applies. New clients should omit."
          },
          "history": {
            "type": "array",
            "maxItems": 40,
            "items": {
              "$ref": "#/components/schemas/LiveHistoryMessage"
            },
            "description": "Compatibility context: serialized JSON at most 6000 UTF-8 bytes; nonblank text with valid Unicode and no disallowed control characters."
          }
        }
      },
      "LiveSession": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sessionID",
          "transport",
          "deadline",
          "rateVersion",
          "experimental"
        ],
        "properties": {
          "sessionID": {
            "type": "string",
            "format": "uuid"
          },
          "transport": {
            "$ref": "#/components/schemas/LiveTransport"
          },
          "deadline": {
            "type": "string",
            "format": "date-time"
          },
          "rateVersion": {
            "type": "string"
          },
          "experimental": {
            "const": true
          },
          "sdp": {
            "type": "string",
            "deprecated": true,
            "description": "Legacy WebRTC response alias only."
          },
          "fundingMode": {
            "type": "string",
            "enum": [
              "minutes",
              "ai-value"
            ]
          },
          "billingBasis": {
            "type": "string",
            "enum": [
              "connected-conversation-time",
              "actual-ai-usage"
            ]
          },
          "minimumChargeMilliseconds": {
            "type": "integer",
            "minimum": 0
          },
          "billingPolicy": {
            "type": "string",
            "enum": [
              "connected-time-only-v1",
              "connected-time-15s-minimum-v1",
              "actual-ai-usage-15s-minimum-v1"
            ]
          },
          "reservedMilliseconds": {
            "type": "integer",
            "minimum": 0
          },
          "limitMilliseconds": {
            "type": "integer",
            "minimum": 0
          },
          "reservedNanoUSD": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "voiceReservedNanoUSD": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "helperReservedNanoUSD": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "helperRateVersion": {
            "type": "string"
          }
        }
      },
      "LiveSessionStatus": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sessionID",
          "state",
          "deadline",
          "observedMilliseconds",
          "providerCostNanoUSD"
        ],
        "properties": {
          "sessionID": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string",
            "enum": [
              "creating",
              "active",
              "closing",
              "closed",
              "incomplete"
            ]
          },
          "deadline": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "observedMilliseconds": {
            "type": "integer",
            "minimum": 0
          },
          "providerCostNanoUSD": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9]+$"
          },
          "fundingMode": {
            "type": "string",
            "enum": [
              "minutes",
              "ai-value"
            ]
          },
          "billingBasis": {
            "type": "string",
            "enum": [
              "connected-conversation-time",
              "actual-ai-usage"
            ]
          },
          "minimumChargeMilliseconds": {
            "type": "integer",
            "minimum": 0
          },
          "billingPolicy": {
            "type": "string",
            "enum": [
              "connected-time-only-v1",
              "connected-time-15s-minimum-v1",
              "actual-ai-usage-15s-minimum-v1"
            ]
          },
          "reservedMilliseconds": {
            "type": "integer",
            "minimum": 0
          },
          "limitMilliseconds": {
            "type": "integer",
            "minimum": 0
          },
          "reservedNanoUSD": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "voiceReservedNanoUSD": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "helperReservedNanoUSD": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "helperRateVersion": {
            "type": "string"
          },
          "chargedMilliseconds": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "chargedNanoUSD": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9]+$"
          },
          "chargedVoiceNanoUSD": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9]+$"
          },
          "chargedHelperNanoUSD": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "helperPendingNanoUSD": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "helperReservedRemainingNanoUSD": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "rateVersion": {
            "type": "string"
          }
        }
      },
      "TranslationTask": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "funding",
          "text",
          "targetLanguage"
        ],
        "properties": {
          "kind": {
            "const": "translation"
          },
          "funding": {
            "$ref": "#/components/schemas/LiveSessionFunding"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "sourceLanguage": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 16
          },
          "targetLanguage": {
            "type": "string",
            "enum": [
              "English",
              "French",
              "German",
              "Spanish",
              "Norwegian",
              "Portuguese",
              "Italian",
              "Chinese (Simplified)",
              "Polish",
              "Arabic",
              "Ukrainian"
            ]
          }
        }
      },
      "AssessmentTask": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "funding",
          "language",
          "context",
          "passage"
        ],
        "properties": {
          "kind": {
            "const": "assessment"
          },
          "funding": {
            "$ref": "#/components/schemas/LiveSessionFunding"
          },
          "language": {
            "type": "string",
            "minLength": 2,
            "maxLength": 16
          },
          "context": {
            "$ref": "#/components/schemas/TaskConversationContext"
          },
          "passage": {
            "$ref": "#/components/schemas/AssessmentPassage"
          }
        }
      },
      "TeachingReplyTask": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "funding",
          "language",
          "text",
          "context"
        ],
        "properties": {
          "kind": {
            "const": "teachingReply"
          },
          "funding": {
            "$ref": "#/components/schemas/LiveSessionFunding"
          },
          "language": {
            "type": "string",
            "minLength": 2,
            "maxLength": 16
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "context": {
            "$ref": "#/components/schemas/TaskConversationContext"
          }
        }
      },
      "TopicSearchTask": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "funding",
          "query",
          "language"
        ],
        "properties": {
          "kind": {
            "const": "topicSearch"
          },
          "funding": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/LiveSessionFunding"
              },
              {
                "$ref": "#/components/schemas/AccountAIValueFunding"
              }
            ]
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "language": {
            "type": "string",
            "minLength": 2,
            "maxLength": 16
          }
        }
      },
      "LiveSessionFunding": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "sessionID"
        ],
        "properties": {
          "type": {
            "const": "liveSession"
          },
          "sessionID": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "AccountAIValueFunding": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "const": "account"
          }
        }
      },
      "TaskConversationContext": {
        "type": "array",
        "maxItems": 10,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "speaker",
            "text"
          ],
          "properties": {
            "speaker": {
              "type": "string",
              "enum": [
                "user",
                "assistant"
              ]
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          }
        }
      },
      "AssessmentPassage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "fragments"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "fragments": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "text",
                "meaningVisible",
                "typed"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                "meaningVisible": {
                  "type": "boolean"
                },
                "typed": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      },
      "ModelTaskRequest": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/TranslationTask"
          },
          {
            "$ref": "#/components/schemas/AssessmentTask"
          },
          {
            "$ref": "#/components/schemas/TeachingReplyTask"
          },
          {
            "$ref": "#/components/schemas/TopicSearchTask"
          }
        ],
        "discriminator": {
          "propertyName": "kind"
        }
      },
      "TaskUsage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "inputTokens",
          "outputTokens",
          "searchCalls"
        ],
        "properties": {
          "inputTokens": {
            "type": "integer",
            "minimum": 0
          },
          "outputTokens": {
            "type": "integer",
            "minimum": 0
          },
          "searchCalls": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "SourceLink": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "url"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "url": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          }
        }
      },
      "TextTaskResultBase": {
        "type": "object",
        "required": [
          "text",
          "sources",
          "usage"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SourceLink"
            }
          },
          "usage": {
            "$ref": "#/components/schemas/TaskUsage"
          }
        }
      },
      "TranslationTaskResult": {
        "unevaluatedProperties": false,
        "allOf": [
          {
            "$ref": "#/components/schemas/TextTaskResultBase"
          },
          {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "translation"
              }
            }
          }
        ]
      },
      "TeachingReplyTaskResult": {
        "unevaluatedProperties": false,
        "allOf": [
          {
            "$ref": "#/components/schemas/TextTaskResultBase"
          },
          {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "teachingReply"
              }
            }
          }
        ]
      },
      "TopicSearchTaskResult": {
        "unevaluatedProperties": false,
        "allOf": [
          {
            "$ref": "#/components/schemas/TextTaskResultBase"
          },
          {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "topicSearch"
              }
            }
          }
        ]
      },
      "AssessmentResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "outcome",
          "suggestedLevel",
          "nextGoal",
          "capability",
          "words",
          "usage"
        ],
        "properties": {
          "kind": {
            "const": "assessment"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "success",
              "partial",
              "breakdown",
              "uncertain"
            ]
          },
          "suggestedLevel": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "nextGoal": {
            "type": "string"
          },
          "capability": {
            "type": "string"
          },
          "words": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "lemma",
                "meaning",
                "form",
                "quote",
                "language",
                "kind",
                "confidence",
                "sourceIDs"
              ],
              "properties": {
                "lemma": {
                  "type": "string"
                },
                "meaning": {
                  "type": "string"
                },
                "form": {
                  "type": "string"
                },
                "quote": {
                  "type": "string"
                },
                "language": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "exposure",
                    "understanding",
                    "assisted",
                    "independent",
                    "lapse"
                  ]
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "sourceIDs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "usage": {
            "$ref": "#/components/schemas/TaskUsage"
          }
        }
      },
      "ConversationEventInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
