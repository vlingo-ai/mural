          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "eventID",
                "speaker",
                "text",
                "source",
                "createdAt"
              ],
              "properties": {
                "eventID": {
                  "type": "string"
                },
                "speaker": {
                  "type": "string",
                  "enum": [
                    "user",
