                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "result"
            ],
            "properties": {
              "type": {
                "const": "mural.meaning.completed"
              },
              "result": {
                "$ref": "#/components/schemas/HostedHelperResult"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "code",
              "reference"
            ],
            "properties": {
              "type": {
                "const": "mural.meaning.error"
              },
              "code": {
                "type": "string"
              },
              "reference": {
                "type": "string"
              }
            }
          }
        ]
      }
    }
  }
