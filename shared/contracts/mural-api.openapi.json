                },
                "url": {
                  "type": "string"
                }
              }
            }
          },
          "usage": {
            "$ref": "#/components/schemas/HostedHelperUsage"
          },
          "costNanoUSD": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "rateVersion": {
            "type": "string"
          }
        }
      },
      "HostedHelperStreamEvent": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "delta"
            ],
            "properties": {
              "type": {
                "const": "mural.meaning.delta"
              },
