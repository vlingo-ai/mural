# Copy to .env on the staging VPS, replace every REQUIRED value, then chmod 600 .env.
# Never commit .env. Image references must be immutable registry digests.
COMPOSE_PROJECT_NAME=vlingo-speaking-live-staging
WEB_DOMAIN=speaking-live-staging.vlingo.ai
API_DOMAIN=api-speaking-live-staging.vlingo.ai
MURAL_API_IMAGE=vlingo-speaking-live-api:REQUIRED_MURAL_GIT_SHA
MODEL_GATEWAY_IMAGE=registry.example.invalid/vlingo/model-gateway@sha256:REQUIRED
LIVEKIT_WORKER_IMAGE=registry.example.invalid/vlingo/livekit-gpt-live-worker@sha256:REQUIRED

# LiveKit Cloud Build project vlingo-speaking-live-staging.
LIVEKIT_URL=wss://REQUIRED.livekit.cloud
LIVEKIT_API_KEY=REQUIRED
LIVEKIT_API_SECRET=REQUIRED
LIVEKIT_CONTROL_SECRET=REQUIRED_MINIMUM_32_RANDOM_CHARACTERS
LIVEKIT_AGENT_NAME=vlingo-speaking-live-gpt-live

# Use separate provider keys so Worker and Responses Router can be revoked independently.
WORKER_OPENAI_API_KEY=REQUIRED
GATEWAY_OPENAI_API_KEY=REQUIRED
GATEWAY_API_KEY=REQUIRED_MINIMUM_32_RANDOM_CHARACTERS
GATEWAY_OPENAI_MODEL_TRANSLATION_FAST=REQUIRED_LOGICAL_ROUTE_TARGET
GATEWAY_OPENAI_MODEL_ASSESSMENT_DEFAULT=REQUIRED_LOGICAL_ROUTE_TARGET
GATEWAY_OPENAI_MODEL_REASONING_DEFAULT=REQUIRED_LOGICAL_ROUTE_TARGET
GATEWAY_OPENAI_MODEL_SEARCH_DEFAULT=REQUIRED_LOGICAL_ROUTE_TARGET

# PostgreSQL is bound only to VPS loopback. Percent-encode characters used in DATABASE_URL.
POSTGRES_PASSWORD=REQUIRED_URL_SAFE_RANDOM_PASSWORD

# Restricted Build access: comma-separated existing staging account UUIDs only.
HOSTED_VOICE_ACCOUNT_ALLOWLIST=REQUIRED_ACCOUNT_UUID
HOSTED_VOICE_LIFETIME_CAP_NANO=REQUIRED_BOUNDED_NONZERO_VALUE
HOSTED_HELPER_BUDGET_PER_MINUTE_NANO=REQUIRED_REVIEWED_VALUE
ACCOUNTS_HMAC_KEY=REQUIRED_64_LOWERCASE_HEX
ACCOUNTS_PROXY_TOKEN=REQUIRED_MINIMUM_32_RANDOM_CHARACTERS
# Phase 5.5B validates the Web client only. Leave this empty until the Phase 6 app owns its bundle ID.
GOOGLE_IOS_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=REQUIRED_WEB_OAUTH_CLIENT_ID
GOOGLE_ANDROID_SERVER_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_IDS=
APPLE_CLIENT_ID=

# Browser build values are public identifiers, not secrets.
VITE_GOOGLE_CLIENT_ID=REQUIRED_WEB_OAUTH_CLIENT_ID

# Encrypted-backup recipient used by backup.sh; no private key belongs on this host.
AGE_RECIPIENT=REQUIRED_AGE_RECIPIENT
